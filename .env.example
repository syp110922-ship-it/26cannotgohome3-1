# Server binding
HOST=0.0.0.0
PORT=3000

# Storage paths
DATA_DIR=./data
VIDEOS_DIR=./data/videos
DB_PATH=./data/app.db

# Security & Auth
# Leave AUTH_SECRET empty in production to auto-generate and persist in SQLite settings,
# or set a strong 64-char hex secret.
AUTH_SECRET=
INITIAL_PIN=1234
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MS=60000
ADMIN_TOKEN_TTL_SEC=43200
DEVICE_TOKEN_TTL_SEC=2592000

# CORS / WebSocket Origin allowlist (comma-separated, * allows all in local dev)
ALLOWED_ORIGINS=*
SERVE_FRONTEND=true

# Playback & Sync State Machine
REQUIRED_DISPLAYS=A,B
ARCHIVE_RETENTION=3
MIN_DISK_FREE_BYTES=536870912
HEARTBEAT_TIMEOUT_MS=15000
COOLDOWN_MS=3000
PLAY_SCHEDULE_LEAD_MS=300
PLAYBACK_SAFETY_MARGIN_MS=10000
MSG_DUPLICATE_WINDOW_MS=2000
